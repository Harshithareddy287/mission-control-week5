# Copy to .env and fill in. Never commit .env.
# "fake" = offline canned replies; anything else = real model via the Responses API.
LLM_PROVIDER=openai
# Your Azure AI Foundry deployment name.
MODEL_NAME=gpt-6-sol
# Azure AI Foundry OpenAI-compatible endpoint (v1), e.g.:
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1/
OPENAI_API_KEY=your-api-key-here
